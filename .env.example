# Cognitest — local development environment
# Copy to .env and adjust as needed. All values below match docker-compose.yml
# defaults, so the quickstart works without editing anything.
# NEVER commit a real .env — it is gitignored.

NODE_ENV=development

# --- API ---
PORT=3001
# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:3000

# --- PostgreSQL (docker-compose: postgres, pgvector/pgvector:pg17) ---
# Runtime URL: use the non-owner cognitest_app role so row-level security applies.
# The owner role (cognitest) BYPASSES RLS on non-forced tables — never run the API with it.
DATABASE_URL=postgres://cognitest_app:cognitest_app@localhost:5432/cognitest
# Owner URL for migrations/seed only (they legitimately bypass RLS)
DATABASE_URL_MIGRATIONS=postgres://cognitest:cognitest@localhost:5432/cognitest
DB_POOL_MAX=10

# --- Redis (docker-compose: redis) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Public origin of the web app (CSRF allowlist, mail links, OIDC redirect base)
WEB_ORIGIN=http://localhost:3000
# Master secret (min 32 chars); generate with: openssl rand -base64 48
AUTH_SECRET=dev-only-auth-secret-change-me-0123456789
# Session lifetime in seconds (default 30 days)
SESSION_TTL_SECONDS=2592000

# --- OIDC providers (optional locally — provider is disabled when unset) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# --- Object storage (docker-compose: minio, S3-compatible) ---
# MinIO console: http://localhost:9001 (login with the access key/secret below)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=cognitest
S3_SECRET_KEY=cognitest123
S3_BUCKET=cognitest-artifacts
S3_REGION=us-east-1

# --- JWT (not used yet — reserved for the auth phase) ---
# Generate real values with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me

# --- Mail (docker-compose: mailpit; UI at http://localhost:8025) ---
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_FROM=noreply@cognitest.local

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:3001
