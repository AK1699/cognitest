{
  "name": "cognitest",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:migrate": "pnpm --filter @cognitest/api migrate",
    "db:seed": "pnpm --filter @cognitest/api seed",
    "format": "prettier --write ."
  },
  "prettier": "@cognitest/config/prettier.config.mjs",
  "devDependencies": {
    "@cognitest/config": "workspace:*",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  }
}
